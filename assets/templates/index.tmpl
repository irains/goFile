    queueMicrotask(() => {
      schedulingUploads = false;
      while (activeUploadWorkers < MAX_FILE_WORKERS) {
        const task = Array.from(tasks.values()).find(candidate => !candidate.running && candidate.file && candidate.state === 'queued' && candidate.intent !== 'paused' && candidate.intent !== 'cancel');
        if (!task) break;
        activeUploadWorkers++;
        runUpload(task).finally(() => { activeUploadWorkers--; scheduleUploads(); });
      }
    });
  }
  async function prepareTask(task) {
    const hasPersistedDigest = !!task.sha256;
    setTaskState(task, hasPersistedDigest ? 'verifying' : 'preparing', '', true);
    try {
      const digest = await hashBlob(task.file, task);
      if (task.intent === 'cancel') { await removeUpload(task); return; }
      if (task.intent === 'paused') { setTaskState(task, 'paused', '', true); return; }
      if (hasPersistedDigest && digest !== task.sha256) { task.file = null; setTaskState(task, 'reselect', 'selectedFileMismatch', true); return; }
      if (!hasPersistedDigest) { task.sha256 = digest; await saveUpload(task); }
      task.needsHash = false;
      if (hasPersistedDigest) { task.status = null; if (!await reconcileUpload(task)) return; }
      setTaskState(task, 'queued', '', true);
      scheduleUploads();
    } catch (error) {
      if (error.code === 'aborted' && task.intent === 'cancel') { await removeUpload(task); return; }
      if (error.code === 'aborted' && task.intent === 'paused') { setTaskState(task, 'paused', '', true); return; }
      setTaskState(task, hasPersistedDigest ? 'reselect' : 'failed', error.code || 'operationFailed', true);
    }
  }
  async function prepareNewUpload(file) {
    if (!uploadDB) { showNotice(strings.uploadStorageUnavailable, true); return; }
    const task = {id: randomHex(16), token: randomHex(32), path: rawPath, name: file.name, size: file.size, lastModified: file.lastModified, sha256: '', createdAt: Date.now(), file, state: 'preparing', error: '', intent: '', status: null, currentPartBytes: 0, xhr: null, running: false, retryTimer: null, cancelFailed: false, needsHash: true};
    tasks.set(task.id, task); renderUploadQueue();
    await prepareTask(task);
  }
  async function bindReselectedFile(task, file) {
    if (file.name !== task.name || file.size !== task.size) { setTaskState(task, 'reselect', 'selectedFileMismatch', true); return; }
    task.intent = ''; task.file = file; task.lastModified = file.lastModified; task.needsHash = true;
    await prepareTask(task);
  }
  function pauseUpload(task) { task.intent = 'paused'; if (task.retryTimer) { clearTimeout(task.retryTimer); task.retryTimer = null; } if (task.xhr) task.xhr.abort(); setTaskState(task, 'paused', '', true); maybeRefreshListing(); }
  function resumeUpload(task) { task.intent = ''; if (!task.file) { task.error = ''; setTaskState(task, 'reselect', '', true); return; } if (task.needsHash) { prepareTask(task); return; } setTaskState(task, 'queued', '', true); scheduleUploads(); }
  function retryUpload(task) { task.error = ''; task.cancelFailed = false; task.intent = ''; if (!task.file) { setTaskState(task, 'reselect', '', true); return; } if (task.needsHash) { prepareTask(task); return; } setTaskState(task, 'queued', '', true); scheduleUploads(); }
  async function cancelUpload(task) {
    task.intent = 'cancel'; task.cancelFailed = false; if (task.retryTimer) { clearTimeout(task.retryTimer); task.retryTimer = null; } if (task.xhr) task.xhr.abort();
    if (!task.status) { await removeUpload(task); return; }
    setTaskState(task, 'cancelling', '', true);
    try { await uploadRequest('/api/uploads/' + encodeURIComponent(task.id), 'DELETE', undefined, task.token); await deleteUpload(task); tasks.delete(task.id); renderUploadQueue(); announceUpload({name: task.name, state: 'cancelled'}); }
    catch (error) { try { if (!await reconcileUpload(task) && task.state === 'cancelled') { await deleteUpload(task); tasks.delete(task.id); renderUploadQueue(); return; } } catch (_) {} task.intent = ''; task.cancelFailed = true; setTaskState(task, 'failed', 'cancelFailed', true); }
  }
  async function removeUpload(task) { if (task.xhr) task.xhr.abort(); if (task.retryTimer) clearTimeout(task.retryTimer); try { await deleteUpload(task); } catch (_) {} tasks.delete(task.id); renderUploadQueue(); maybeRefreshListing(); }
  function maybeRefreshListing() {
    if (!listingRefreshNeeded || listingRefreshScheduled) return;
    const needsPage = Array.from(tasks.values()).some(task => task.file || ['preparing', 'verifying', 'queued', 'uploading', 'retrying', 'finalizing', 'cancelling'].includes(task.state));
    if (!needsPage) { listingRefreshScheduled = true; setTimeout(() => location.reload(), 450); }
  }
  async function restoreUploads() {
    try {
      uploadDB = await openUploadDB();
      const records = await loadUploads();
      for (const record of records) {
        if (record.version !== 1 || record.scope !== uploadScope || !record.id || !record.token || !record.sha256) continue;
        const task = Object.assign({file: null, state: 'reselect', error: '', intent: '', status: null, currentPartBytes: 0, xhr: null, running: false, retryTimer: null, cancelFailed: false, needsHash: true}, record);
        tasks.set(task.id, task);
      }
      renderUploadQueue();
      for (const task of tasks.values()) { try { await reconcileUpload(task); } catch (error) { setTaskState(task, 'reselect', error.code || 'operationFailed'); } }
    } catch (_) { uploadDB = null; if (input) { input.disabled = true; drop?.setAttribute('aria-disabled', 'true'); } showNotice(strings.uploadStorageUnavailable, true); }
  }
  input?.addEventListener('change', () => { const files = Array.from(input.files || []); input.value = ''; files.forEach(file => prepareNewUpload(file)); });
  drop?.addEventListener('dragover', event => { event.preventDefault(); drop.classList.add('dragover'); });
  drop?.addEventListener('dragleave', () => drop.classList.remove('dragover'));
  drop?.addEventListener('drop', event => { event.preventDefault(); drop.classList.remove('dragover'); Array.from(event.dataTransfer.files || []).forEach(file => prepareNewUpload(file)); });
  if (queue) restoreUploads();
})();
</script>
