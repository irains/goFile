<!DOCTYPE html>
<html lang="{{.htmlLang}}" data-bs-theme="dark">
{{template "public/header" .}}
<body>
<a class="skip-link" href="#workspace">{{t "dls"}}</a>
<div class="app-shell">
  <header class="app-header">
    <a class="brand" href="{{appPath "/"}}" aria-label="FileHarbor {{t "dls"}}">
      <span class="brand-mark">› FileHarbor</span>
      <span class="brand-subtitle">{{t "appSubtitle"}}</span>
    </a>
    <div class="user-menu">
      <span class="user-avatar" aria-hidden="true">A</span>
      <span class="user-name">{{.username}}</span>
      <button type="button" class="btn btn-sm btn-outline-secondary" id="logoutButton">{{t "logout"}}</button>
    </div>
  </header>

  <nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="{{appPath "/"}}">~</a></li>
      {{if .rawPath}}<li class="breadcrumb-item active" aria-current="page">{{.rawPath}}</li>{{end}}
    </ol>
  </nav>

  {{if .diskTotal}}
  <div class="mb-4" aria-label="Disk usage">
    <div class="d-flex justify-content-between small text-secondary mb-2"><span>{{.diskFree}} free</span><span>{{.diskTotal}}</span></div>
    <div class="disk-meter"><span style="width:{{.diskPct}}%"></span></div>
  </div>
  {{end}}

  <main id="workspace" aria-busy="false">
    <div class="workspace-toolbar">
      <div>
        <h1 class="workspace-title">{{t "dls"}}</h1>
        <p class="workspace-meta">{{.rawPath}}{{if not .rawPath}}/{{end}} · {{len .info.Entries}} {{t "selected"}}</p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-outline-secondary" type="button" id="refreshButton">↻ {{t "refresh"}}</button>
        {{if .hasParent}}<a class="btn btn-outline-secondary" href="{{.prev}}">← {{t "back"}}</a>{{end}}
        {{if not .reader}}
        <button class="btn btn-outline-secondary" type="button" data-action="new-file">+ {{t "nFile"}}</button>
        <button class="btn btn-primary" type="button" data-action="new-folder">+ {{t "nDir"}}</button>
        {{end}}
      </div>
    </div>

    {{if or .info.Entries .hasParent}}
    <div class="table-wrap">
      <table class="table table-hover align-middle" id="fileTable">
        <thead>
          <tr>
            <th scope="col" style="width:3rem"><input class="form-check-input" type="checkbox" id="selectAll" aria-label="{{t "selectAll"}}"></th>
            <th scope="col">{{t "name"}}</th>
            <th scope="col" class="col-type">{{t "kind"}}</th>
            <th scope="col" class="col-size">{{t "size"}}</th>
            <th scope="col" class="col-modified">{{t "modified"}}</th>
            <th scope="col" class="text-end" style="width:3.5rem"><span class="visually-hidden">{{t "actions"}}</span></th>
          </tr>
        </thead>
        <tbody>
          {{if .hasParent}}
          <tr class="parent-row">
            <td></td>
            <td><a class="parent-link" href="{{.prev}}"><span aria-hidden="true">↖</span>..</a></td>
            <td class="col-type"><span class="kind-badge">{{t "upOneLevel"}}</span></td>
            <td class="col-size"></td>
            <td class="col-modified"></td>
            <td></td>
          </tr>
          {{end}}
          {{range .info.Entries}}
          <tr data-entry="true" data-name="{{.Name}}" data-path="{{.Path}}" data-version="{{.Version}}" data-kind="{{.Kind}}">
            <td><input class="form-check-input entry-check" type="checkbox" aria-label="{{t "selectItem"}} {{.Name}}"></td>
            <td>
              <div class="d-flex align-items-center gap-2 min-w-0">
                <span class="item-icon {{if eq .Kind "directory"}}folder{{end}}" aria-hidden="true">{{if eq .Kind "directory"}}▸{{else}}·{{end}}</span>
                {{if eq .Kind "directory"}}<a class="item-name" href="{{appPath (printf "/d/%s" .Path)}}">{{.Name}}</a>{{else}}<a class="item-name" href="{{appPath (printf "/download/%s" .Path)}}">{{.Name}}</a>{{end}}
              </div>
              <div class="item-meta-mobile">{{if eq .Kind "directory"}}{{t "folder"}}{{else}}{{if .Extension}}{{.Extension}}{{else}}{{t "file"}}{{end}}{{end}} · <span data-size="{{.Size}}"></span> · <time datetime="{{.Modified.Format "2006-01-02T15:04:05Z07:00"}}" data-time="{{.Modified.Unix}}"></time></div>
            </td>
            <td class="col-type"><span class="kind-badge">{{if eq .Kind "directory"}}{{t "folder"}}{{else}}{{if .Extension}}{{.Extension}}{{else}}{{t "file"}}{{end}}{{end}}</span></td>
            <td class="col-size text-secondary"><span data-size="{{.Size}}">{{.Size}}</span></td>
            <td class="col-modified text-secondary"><time datetime="{{.Modified.Format "2006-01-02T15:04:05Z07:00"}}" data-time="{{.Modified.Unix}}">{{.Modified.Format "2006-01-02 15:04"}}</time></td>
            <td class="text-end">
              <div class="dropdown">
                <button class="btn btn-sm btn-icon btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{t "more"}} {{.Name}}">⋯</button>
                <ul class="dropdown-menu dropdown-menu-end">
                  {{if eq .Kind "directory"}}<li><a class="dropdown-item" href="{{appPath (printf "/d/%s" .Path)}}">↗ {{t "folder"}}</a></li>{{else}}<li><a class="dropdown-item" href="{{appPath (printf "/download/%s" .Path)}}">↓ {{t "download"}}</a></li>{{if previewable .Path}}<li><a class="dropdown-item" target="_blank" href="{{appPath (printf "/view/%s" .Path)}}">◌ {{t "view"}}</a></li>{{end}}{{if not $.reader}}<li><a class="dropdown-item" target="_blank" href="{{appPath (printf "/edit/%s" .Path)}}">⌘ {{t "edit"}}</a></li>{{end}}{{end}}
                  <li><button class="dropdown-item" type="button" data-action="properties">ⓘ {{t "properties"}}</button></li>
                  {{if not $.reader}}
                  <li><hr class="dropdown-divider"></li>
                  <li><button class="dropdown-item" type="button" data-action="rename">↻ {{t "rename"}}</button></li>
                  <li><button class="dropdown-item" type="button" data-action="move">→ {{t "move"}}</button></li>
                  <li><button class="dropdown-item" type="button" data-action="copy">⧉ {{t "copy"}}</button></li>
                  {{if eq .Kind "directory"}}<li><button class="dropdown-item" type="button" data-action="zip">⌑ {{t "zip"}}</button></li>{{else}}{{if .IsArchive}}<li><button class="dropdown-item" type="button" data-action="unzip">⌑ {{t "unzip"}}</button></li>{{end}}<li><button class="dropdown-item" type="button" data-action="md5"># {{t "md5"}}</button></li>{{end}}
                  <li><hr class="dropdown-divider"></li>
                  <li><button class="dropdown-item danger" type="button" data-action="delete">× {{t "del"}}</button></li>
                  {{end}}
                </ul>
              </div>
            </td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
    {{else}}
    <section class="empty-state" aria-label="{{t "empty"}}"><p class="mb-0">{{t "empty"}}</p></section>
    {{end}}

    <section id="bulkBar" class="bulk-bar" aria-label="{{t "actions"}}">
      <span class="bulk-count" id="bulkCount">0 {{t "selected"}}</span>
      {{if not .reader}}<button class="btn btn-sm btn-outline-secondary" type="button" data-batch-action="move">→ {{t "batchMove"}}</button><button class="btn btn-sm btn-outline-secondary" type="button" data-batch-action="copy">⧉ {{t "batchCopy"}}</button>{{end}}
      <button class="btn btn-sm btn-outline-secondary" type="button" data-batch-action="download">↓ {{t "downloadZip"}}</button>
      <span class="bulk-spacer"></span>
      {{if not .reader}}<button class="btn btn-sm btn-outline-danger" type="button" data-batch-action="delete">× {{t "batchDelete"}}</button>{{end}}
      <button class="btn btn-sm btn-outline-secondary" type="button" id="clearSelection">{{t "clear"}}</button>
    </section>

    {{if .allowUpload}}
    <section class="upload-panel" aria-labelledby="uploadHeading">
      <div class="d-flex align-items-baseline justify-content-between gap-3 mb-3"><h2 class="h6 mb-0" id="uploadHeading">{{t "upload"}}</h2><span class="small text-secondary" id="uploadQueueSummary">{{t "uploadQueueEmpty"}}</span></div>
      <div class="drop-zone" id="dropZone"><span>{{t "uploadHint"}}</span><input type="file" id="fileInput" multiple aria-label="{{t "upload"}}"></div>
      <div class="upload-queue" id="uploadQueue" role="list" aria-label="{{t "uploadQueue"}}"></div>
    </section>
    {{end}}
  </main>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="actionPanel" aria-labelledby="actionPanelTitle">
  <div class="offcanvas-header"><h2 class="offcanvas-title h5" id="actionPanelTitle"></h2><button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="{{t "cancel"}}"></button></div>
  <div class="offcanvas-body">
    <p class="text-secondary" id="actionPanelSummary"></p>
    <div id="actionPanelError" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>
    <div class="mb-3 d-none" id="nameFieldWrap"><label class="form-label" for="actionName">{{t "newName"}}</label><input class="form-control" id="actionName" autocomplete="off"></div>
    <div class="mb-3 d-none" id="destinationFieldWrap">
      <label class="form-label">{{t "destination"}}</label>
      <div class="folder-picker" id="folderPicker">
        <div class="folder-picker-toolbar">
          <button type="button" class="btn btn-sm btn-outline-secondary" id="pickerUp" data-picker-control aria-label="{{t "upOneLevel"}}">←</button>
          <span class="folder-picker-path" id="pickerPath"></span>
          <button type="button" class="btn btn-sm btn-primary" id="pickerUse" data-picker-control>{{t "useThisFolder"}}</button>
        </div>
        <div class="folder-list" id="folderList"></div>
      </div>
      <div class="destination-summary mt-2" id="selectedDestination"></div>
      <div class="form-text text-secondary">{{t "keepName"}}</div>
    </div>
    <div id="propertiesContent" class="small"></div>
    <div class="d-flex justify-content-end gap-2 mt-4" id="actionPanelButtons"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">{{t "cancel"}}</button><button type="button" class="btn btn-primary" id="actionSubmit">{{t "confirm"}}</button></div>
  </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="deleteModalTitle">{{t "deleteTitle"}}</h2><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="{{t "cancel"}}"></button></div><div class="modal-body"><p id="deleteSummary"></p><p class="text-danger mb-0">{{t "deleteHint"}}</p></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{t "cancel"}}</button><button type="button" class="btn btn-danger" id="confirmDelete">{{t "deleteItems"}}</button></div></div></div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3"><div id="noticeToast" class="toast" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body" id="noticeText"></div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="{{t "cancel"}}"></button></div></div></div>
<div class="status-live" id="liveStatus" aria-live="polite"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script>
(function () {
  const labels = {{js (t "operationFailed")}};
  const strings = {
    selected: {{js (t "selected")}}, working: {{js (t "working")}}, confirm: {{js (t "confirm")}}, properties: {{js (t "properties")}},
    rename: {{js (t "rename")}}, move: {{js (t "move")}}, copy: {{js (t "copy")}},
    newFile: {{js (t "nFile")}}, newFolder: {{js (t "nDir")}}, zip: {{js (t "zip")}}, unzip: {{js (t "unzip")}}, md5: {{js (t "md5")}},
    propertiesLoading: {{js (t "propertiesLoading")}}, operationFailed: labels,
    deleteTitle: {{js (t "deleteTitle")}}, deleteItems: {{js (t "deleteItems")}}, incomplete: {{js (t "incomplete")}},
    workspaceRoot: {{js (t "workspaceRoot")}}, useThisFolder: {{js (t "useThisFolder")}}, selectedDestination: {{js (t "selectedDestination")}},
    destinationRequired: {{js (t "destinationRequired")}}, loadingFolders: {{js (t "loadingFolders")}}, noSubfolders: {{js (t "noSubfolders")}},
    uploadQueue: {{js (t "uploadQueue")}}, uploadQueueEmpty: {{js (t "uploadQueueEmpty")}}, uploadQueued: {{js (t "uploadQueued")}}, uploadPreparing: {{js (t "uploadPreparing")}}, uploadReselect: {{js (t "uploadReselect")}}, selectOriginalFile: {{js (t "selectOriginalFile")}}, verifyingFile: {{js (t "verifyingFile")}}, selectedFileMismatch: {{js (t "selectedFileMismatch")}}, uploading: {{js (t "uploading")}}, uploadFinalizing: {{js (t "uploadFinalizing")}}, uploadComplete: {{js (t "uploadComplete")}}, uploadCancelled: {{js (t "uploadCancelled")}}, uploadFailed: {{js (t "uploadFailed")}}, pause: {{js (t "pause")}}, uploadPaused: {{js (t "uploadPaused")}}, cancelUpload: {{js (t "cancelUpload")}}, cancellingUpload: {{js (t "cancellingUpload")}}, cancelFailed: {{js (t "cancelFailed")}}, retryCancel: {{js (t "retryCancel")}}, retry: {{js (t "retry")}}, retrying: {{js (t "retrying")}}, resume: {{js (t "resume")}}, removeFromQueue: {{js (t "removeFromQueue")}}, uploadStorageUnavailable: {{js (t "uploadStorageUnavailable")}}, resolveDestinationConflict: {{js (t "resolveDestinationConflict")}},
    invalid_path: {{js (t "invalid_path")}}, invalid_name: {{js (t "invalid_name")}}, not_found: {{js (t "not_found")}}, not_directory: {{js (t "not_directory")}}, destination_exists: {{js (t "destination_exists")}}, destination_same_directory: {{js (t "destination_same_directory")}}, source_changed: {{js (t "source_changed")}}, self_descendant: {{js (t "self_descendant")}}, cross_device_move: {{js (t "cross_device_move")}}, batch_limit_exceeded: {{js (t "batch_limit_exceeded")}}, archive_limit_exceeded: {{js (t "archive_limit_exceeded")}}, root_operation_forbidden: {{js (t "root_operation_forbidden")}}, io_error: {{js (t "io_error")}}, execution_partial: {{js (t "execution_partial")}}, delete_partial: {{js (t "delete_partial")}}, csrf_invalid: {{js (t "csrf_invalid")}}, unauthenticated: {{js (t "unauthenticated")}}, browser_session_required: {{js (t "browser_session_required")}}, invalid_upload: {{js (t "invalid_upload")}}, invalid_part: {{js (t "invalid_part")}}, invalid_digest: {{js (t "invalid_digest")}}, upload_not_found: {{js (t "upload_not_found")}}, upload_expired: {{js (t "upload_expired")}}, upload_cancelled: {{js (t "upload_cancelled")}}, upload_too_large: {{js (t "upload_too_large")}}, size_mismatch: {{js (t "size_mismatch")}}, upload_busy: {{js (t "upload_busy")}}, upload_incomplete: {{js (t "upload_incomplete")}}, part_conflict: {{js (t "part_conflict")}}, insufficient_storage: {{js (t "insufficient_storage")}}
  };
  const rawPath = {{js .rawPath}};
  const appBase = {{js .basePath}};
  const appURL = path => appBase + path;
  const listingToken = {{js .listingToken}};
  const csrf = document.querySelector('meta[name="csrf-token"]').content;
  const selected = new Set();
  const table = document.getElementById('fileTable');
  const selectAll = document.getElementById('selectAll');
  const bulkBar = document.getElementById('bulkBar');
  const bulkCount = document.getElementById('bulkCount');
  const main = document.getElementById('workspace');
  const live = document.getElementById('liveStatus');
  const toast = document.getElementById('noticeToast');
  const toastText = document.getElementById('noticeText');
  const toastInstance = new bootstrap.Toast(toast, {delay: 3600});
  const panelEl = document.getElementById('actionPanel');
  const panel = new bootstrap.Offcanvas(panelEl);
  const panelError = document.getElementById('actionPanelError');
  const panelSubmit = document.getElementById('actionSubmit');
  const destinationWrap = document.getElementById('destinationFieldWrap');
  const pickerPath = document.getElementById('pickerPath');
  const pickerUp = document.getElementById('pickerUp');
  const pickerUse = document.getElementById('pickerUse');
  const folderList = document.getElementById('folderList');
  const destinationSummary = document.getElementById('selectedDestination');
  const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
  const destinationPicker = {browsePath: '', selectedDestination: null, directories: [], loading: false, requestId: 0, submitting: false};
  let actionContext = null;
  let deleteContext = null;

  function showNotice(text, error) { toastText.textContent = text; toast.classList.toggle('border-danger', !!error); toastInstance.show(); live.textContent = text; }
  function formatBytes(value) { const number = Number(value || 0); if (number < 1024) return number + ' B'; const units = ['KB','MB','GB','TB']; let amount = number / 1024, index = 0; while (amount >= 1024 && index < units.length - 1) { amount /= 1024; index++; } return amount.toFixed(amount >= 10 ? 0 : 1) + ' ' + units[index]; }
  function formatTime(value) { return new Intl.DateTimeFormat(undefined, {dateStyle:'medium', timeStyle:'short'}).format(new Date(Number(value) * 1000)); }
  document.querySelectorAll('[data-size]').forEach(el => el.textContent = formatBytes(el.dataset.size));
  document.querySelectorAll('time[data-time]').forEach(el => el.textContent = formatTime(el.dataset.time));

  function setBusy(value) { main.setAttribute('aria-busy', value ? 'true' : 'false'); document.querySelectorAll('button, input').forEach(el => { if (el.closest('#logoutButton') || el.dataset.bsDismiss) return; el.disabled = value; }); }
  function selectedRows() { return Array.from(table ? table.querySelectorAll('tbody tr[data-entry="true"]') : []).filter(row => selected.has(row.dataset.name)); }
  function updateSelection() { const rows = selectedRows(); const checks = table ? Array.from(table.querySelectorAll('tbody tr[data-entry="true"] .entry-check')) : []; checks.forEach(check => { check.checked = selected.has(check.closest('tr').dataset.name); }); if (selectAll) { selectAll.checked = checks.length > 0 && rows.length === checks.length; selectAll.indeterminate = rows.length > 0 && rows.length < checks.length; } if (bulkBar) bulkBar.classList.toggle('visible', rows.length > 0); if (bulkCount) bulkCount.textContent = rows.length + ' ' + strings.selected; }
  function clearSelection() { selected.clear(); updateSelection(); }
  if (table) table.addEventListener('change', event => { if (!event.target.classList.contains('entry-check')) return; const name = event.target.closest('tr').dataset.name; event.target.checked ? selected.add(name) : selected.delete(name); updateSelection(); });
  if (selectAll) selectAll.addEventListener('change', () => { table.querySelectorAll('tbody tr[data-entry="true"]').forEach(row => selectAll.checked ? selected.add(row.dataset.name) : selected.delete(row.dataset.name)); updateSelection(); });
  document.getElementById('clearSelection')?.addEventListener('click', clearSelection);
  document.getElementById('refreshButton')?.addEventListener('click', () => location.reload());

  async function request(path, data, method = 'POST') { const options = {method, headers: {'X-CSRF-Token': csrf}}; if (data !== undefined) { options.headers['Content-Type'] = 'application/json'; options.body = JSON.stringify(data); } const response = await fetch(appURL(path), options); let body = {}; try { body = await response.json(); } catch (_) {} if (!response.ok || !body.ok) { throw new Error(body.code || 'operationFailed'); } return body; }
  function formRequest(path, values) { const body = new URLSearchParams(values); return fetch(appURL(path), {method:'POST', headers:{'X-CSRF-Token': csrf, 'Content-Type':'application/x-www-form-urlencoded'}, body}).then(async response => { const data = await response.json().catch(() => ({})); if (!response.ok || !data.ok) throw new Error(data.code || 'operationFailed'); return data; }); }
  function errorText(error) { return strings[error.message] || strings.operationFailed; }
  function entryFor(row) { return {name: row.dataset.name, path: row.dataset.path, version: row.dataset.version, kind: row.dataset.kind}; }
  function currentEntries() { return selectedRows().map(entryFor); }
  function isMoveOrCopy() { return actionContext && (actionContext.type === 'move' || actionContext.type === 'copy'); }
  function displayFolderPath(path) { return path ? '/' + path : strings.workspaceRoot; }
  function parentFolderPath(path) { const separator = path.lastIndexOf('/'); return separator === -1 ? '' : path.slice(0, separator); }
  function clearPanelError() { panelError.textContent = ''; panelError.classList.add('d-none'); }
  function showPanelError(error) { panelError.textContent = typeof error === 'string' ? error : errorText(error); panelError.classList.remove('d-none'); panelError.focus(); }

  function renderFolderPicker() {
    pickerPath.textContent = displayFolderPath(destinationPicker.browsePath);
    pickerUp.disabled = destinationPicker.submitting || destinationPicker.loading || destinationPicker.browsePath === '';
    pickerUse.disabled = destinationPicker.submitting || destinationPicker.loading;
    pickerUse.textContent = strings.useThisFolder;
    folderList.replaceChildren();
    if (destinationPicker.loading) {
      const message = document.createElement('p'); message.className = 'small text-secondary mb-0'; message.textContent = strings.loadingFolders; folderList.append(message);
    } else if (!destinationPicker.directories.length) {
      const message = document.createElement('p'); message.className = 'small text-secondary mb-0'; message.textContent = strings.noSubfolders; folderList.append(message);
    } else {
      destinationPicker.directories.forEach(directory => {
        const button = document.createElement('button'); button.type = 'button'; button.className = 'btn btn-sm btn-outline-secondary'; button.dataset.pickerControl = 'true'; button.textContent = '▸ ' + directory.name; button.disabled = destinationPicker.submitting;
        button.addEventListener('click', () => loadDirectories(directory.path));
        folderList.append(button);
      });
    }
    destinationSummary.textContent = destinationPicker.selectedDestination === null ? '' : strings.selectedDestination + ': ' + displayFolderPath(destinationPicker.selectedDestination);
    if (isMoveOrCopy()) panelSubmit.disabled = destinationPicker.submitting || destinationPicker.selectedDestination === null;
  }

  async function loadDirectories(path) {
    const requestId = ++destinationPicker.requestId;
    destinationPicker.loading = true;
    destinationPicker.browsePath = path;
    clearPanelError();
    renderFolderPicker();
    try {
      const response = await fetch(appURL('/api/directories?path=' + encodeURIComponent(path)));
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.ok) throw new Error(data.code || 'operationFailed');
      if (requestId !== destinationPicker.requestId) return;
      destinationPicker.browsePath = data.path || '';
      destinationPicker.directories = Array.isArray(data.dirs) ? data.dirs : [];
    } catch (error) {
      if (requestId !== destinationPicker.requestId) return;
      destinationPicker.directories = [];
      showPanelError(error);
    } finally {
      if (requestId === destinationPicker.requestId) { destinationPicker.loading = false; renderFolderPicker(); }
    }
  }

  function chooseCurrentFolder() {
    destinationPicker.selectedDestination = destinationPicker.browsePath;
    clearPanelError();
    renderFolderPicker();
  }

  function setPanelBusy(value) {
    destinationPicker.submitting = value;
    panelEl.setAttribute('aria-busy', value ? 'true' : 'false');
    panelEl.querySelectorAll('[data-bs-dismiss], [data-picker-control]').forEach(control => { control.disabled = value; });
    panelEl.querySelector('.btn-close').disabled = value;
    document.getElementById('actionName').disabled = value;
    panelSubmit.disabled = value || (isMoveOrCopy() && destinationPicker.selectedDestination === null);
    panelSubmit.replaceChildren();
    if (value) { const spinner = document.createElement('span'); spinner.className = 'spinner-border spinner-border-sm me-2'; spinner.setAttribute('aria-hidden', 'true'); panelSubmit.append(spinner, document.createTextNode(strings.working)); }
    else panelSubmit.textContent = strings.confirm;
    if (isMoveOrCopy()) renderFolderPicker();
  }

  pickerUp.addEventListener('click', () => loadDirectories(parentFolderPath(destinationPicker.browsePath)));
  pickerUse.addEventListener('click', chooseCurrentFolder);

  function openPanel(type, row, batch) {
    actionContext = {type, row, batch};
    const nameWrap = document.getElementById('nameFieldWrap'); const content = document.getElementById('propertiesContent'); const buttons = document.getElementById('actionPanelButtons');
    clearPanelError(); content.replaceChildren(); nameWrap.classList.add('d-none'); destinationWrap.classList.add('d-none'); buttons.classList.remove('d-none');
    panelEl.querySelector('.btn-close').disabled = false;
    document.getElementById('actionName').disabled = false;
    destinationPicker.requestId++; destinationPicker.browsePath = ''; destinationPicker.selectedDestination = null; destinationPicker.directories = []; destinationPicker.loading = false; destinationPicker.submitting = false;
    const entries = batch ? currentEntries() : (row ? [entryFor(row)] : []);
    document.getElementById('actionPanelSummary').textContent = batch ? entries.slice(0, 3).map(item => item.name).join(', ') + (entries.length > 3 ? ' +' + (entries.length - 3) : '') : (row ? row.dataset.name : '');
